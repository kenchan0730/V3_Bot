# Copy to data/.env and fill in real values. Never commit data/.env.

# --- Interactive Brokers ---
# TWS paper 7497 / TWS live 7496 / IB Gateway paper 4002 / IB Gateway live 4001
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
# Guard rail: must be "paper" or "live". Live requires explicit opt-in.
IBKR_ACCOUNT_MODE=paper

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email alerts (optional) ---
SMTP_SERVER=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENT=

# --- News sentiment (optional) ---
FINNHUB_KEY=

# --- Capital ---
TOTAL_CAPITAL=1275.0
